trait Score {
    fn score(self) -> i32;
    fn doubled(self) -> i32 { self.score() * 2 }
}

struct First { value: i32 }
struct Second { value: i32 }

impl Score for First {
    fn score(self) -> i32 { self.value }
}

impl Score for Second {
    fn score(self) -> i32 { self.value + 1 }
}

First { value: 3 }.doubled() + Second { value: 4 }.doubled()
