let mut keys: HashSet<Option<i32>> = HashSet::new();
keys.insert(Some(7i32));
keys.insert(None);
let selected: Option<i32> = Some(7i32);
let probe: Option<i32> = Some(7i32);
let missing: Option<i32> = None;
let text: Option<string> = Some("native");
let size: Option<usize> = Some(4usize);
let total = match selected {
    Some(value) => value,
    None => 0i32,
};
if keys.contains(&probe) && keys.contains(&missing)
    && text.is_some() && size.is_some() && missing.is_none() {
    total + 35i32
} else {
    0i32
}
