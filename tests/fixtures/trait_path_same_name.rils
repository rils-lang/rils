trait Left { fn value(&self) -> i32; }
trait Right { fn value(&self) -> i32; }

struct Both { value: i32 }

impl Left for Both {
    fn value(&self) -> i32 { self.value }
}

impl Right for Both {
    fn value(&self) -> i32 { self.value + 1 }
}

fn run() -> i32 {
    let both = Both { value: 20 };
    Left::value(&both) + Right::value(&both) + 1
}

run()
