struct Item { name: string }
struct Holder { values: Vec<Item> }
let mut holder = Holder { values: Vec::new() };
holder.values.push(Item { name: "a" });
let mut source: Vec<Item> = Vec::new();
source.push(Item { name: "b" });
source.push(Item { name: "c" });
holder.values.extend(source);
let empty: Vec<Item> = Vec::new();
holder.values.extend(empty);
let first = holder.values.remove(0);
let second = holder.values.remove(0);
let third = holder.values.pop().unwrap();
first.name + second.name + third.name
