fn converted(value: i32) -> Result<(u8, bool), string> {
    let number = u8::try_from(value)?;
    Ok(number.overflowing_add(1u8))
}
assert!(converted(256).is_err());
let result = converted(255).unwrap();
assert!(result.0 == 0u8 && result.1);
let mut pairs: Vec<(i16, bool)> = Vec::new();
pairs.push(i16::MAX.overflowing_add(1i16));
let last = pairs.pop().unwrap();
assert!(last.0 == i16::MIN && last.1);
true
