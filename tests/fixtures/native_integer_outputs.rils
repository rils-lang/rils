{
    let sum = i8::MAX.overflowing_add(1i8);
    assert!(sum.1);
    let mut copied = sum;
    copied.1 = false;
    assert!(sum.1 && !copied.1);
    assert!(sum.0 == i8::MIN);
    let values = [sum, 1i8.overflowing_mul(2i8)];
    assert!(values[0usize].1 && !values[1usize].1);
    let shifted = 1i8.overflowing_shl(i8::BITS);
    assert!(shifted.0 == 1i8 && shifted.1);
    assert!(i8::MAX.checked_add(1i8).is_none());
    assert!(1i8.checked_add(1i8).unwrap() == 2i8);
    assert!(i8::try_from(1i32).unwrap() == 1i8);
    assert!(i8::try_from(u128::MAX).is_err());
}
