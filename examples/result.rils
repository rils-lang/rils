fn read_number(success: bool) -> Result<i32, string> {
    if success {
        Ok(40)
    } else {
        Err("could not read number")
    }
}

fn add_two(success: bool) -> Result<i32, string> {
    let value = read_number(success)?;
    Ok(value + 2)
}

match add_two(true) {
    Ok(value) => println!("value:", value),
    Err(error) => println!("error:", error),
}
