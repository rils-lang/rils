macro choose_larger {
    ($left:expr, $right:expr) => {
        if ($left) > ($right) { ($left) } else { ($right) }
    }
}

macro bindings {
    ($($name:ident = $value:expr),*) => {
        $(let $name = $value;)*
    }
}

macro print_all {
    ($($value:expr),*) => {{
        $(println!($value);)*
    }}
}

bindings!(left = 20, right = 22)
let answer = choose_larger!(left + right, 40);
print_all!("macro result:", answer);
answer
