struct Box<T> {
    value: T,
}

type ValueBox<T> = Box<T>;
type IntBox = ValueBox<i32>;

trait Factory {
    type Item<T> = Box<T>;
    fn make(self) -> Self::Item<i32>;
}

struct IntFactory {
    value: i32,
}

impl Factory for IntFactory {
    fn make(self) -> Box<i32> {
        Box { value: self.value }
    }
}

let boxed: IntBox = IntFactory { value: 42 }.make();
println!(boxed.value);
