trait Describe {
    fn describe(&self) -> string;
}

trait Value {
    fn value(&self) -> i32;
}

struct Number {
    inner: i32,
}

impl Describe for Number {
    fn describe(&self) -> string {
        "number"
    }
}

impl Value for Number {
    fn value(&self) -> i32 {
        self.inner
    }
}

fn print_value(item: Number) -> i32 {
    println!(
        <Number as Describe>::describe(&item),
        <Number as Value>::value(&item)
    );
    <Number as Value>::value(&item)
}

struct Wrapper<T> {
    item: T,
}

impl<T> Describe for Wrapper<T> {
    fn describe(&self) -> string {
        "wrapper"
    }
}

let number = Number { inner: 42 };
assert!(print_value(number) == 42);
let wrapper = Wrapper { item: number };
println!(<Wrapper<Number> as Describe>::describe(&wrapper));
