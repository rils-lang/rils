// Rils 0.1 基础示例

fn factorial(n: i32) -> i32 {
    let mut current = 2;
    let mut result = 1;
    while current <= n {
        result = result * current;
        current = current + 1;
    }
    result
}

let language = "Rils";
println!("hello from {}", language);
println!("6! = {}", factorial(6));
assert!(factorial(5) == 120, "factorial is broken");
factorial(6)
