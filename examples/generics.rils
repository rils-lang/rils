struct Pair<T, U> {
    first: T,
    second: U,
}

impl<T, U> Pair<T, U> {
    fn swap(self) -> Pair<U, T> {
        Pair {
            first: self.second,
            second: self.first,
        }
    }

    fn replace_first<V>(self, value: V) -> Pair<V, U> {
        Pair {
            first: value,
            second: self.second,
        }
    }
}

enum Outcome<T, E> {
    Ok(T),
    Err(E),
}

fn value_or<T, E>(result: Outcome<T, E>, fallback: T) {
    match result {
        Outcome::Ok(value) => value,
        Outcome::Err(_) => fallback,
    }
}

let pair: Pair<i32, string> = Pair {
    first: 42,
    second: "Rils",
};

let swapped = pair.swap();
println!(clone(&swapped.first), swapped.second);

let replaced = swapped.replace_first(true);
println!(replaced.first, replaced.second);

let failure: Outcome<i32, string> = Outcome::Err("failed");
println!(value_or(failure, 7));
