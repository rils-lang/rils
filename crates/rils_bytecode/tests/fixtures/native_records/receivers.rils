struct Counter { value: i32 }
trait Read { fn read(&self) -> i32; }
impl Read for Counter { fn read(&self) -> i32 { self.value } }
impl Counter {
    fn bump(&mut self) { self.value = self.value + 1; }
    fn finish(self) -> i32 { self.value }
}
let mut counter = Counter { value: 40 };
counter.bump();
let seen = counter.read();
counter.bump();
if seen == 41 { counter.finish() } else { 0 }
