struct Inner { text: string, count: i32 }
struct Outer { inner: Inner }
{
    let cell: RefCell<Outer> = RefCell::new(Outer {
        inner: Inner { text: "owned", count: 4 }
    });
    let item = cell.borrow_mut();
    item.inner.count = 42;
    let current = cell.borrow();
    current.inner.count
}
