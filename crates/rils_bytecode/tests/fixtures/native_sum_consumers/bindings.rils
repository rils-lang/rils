struct Item { text: string, number: i32 }
enum Choice { Empty, Record { item: Item } }
fn run() -> i32 {
    let nested: Option<Result<Choice, string>> = Some(Ok(Choice::Record {
        item: Item { text: "owned", number: 42 }
    }));
    let inner: Result<Choice, string> = match nested { Some(inner) => inner, None => Err("none") };
    let choice = match inner { Ok(choice) => choice, Err(_) => Choice::Empty };
    match choice {
        Choice::Record { item: Item { text, number } } => {
            if text == "owned" { number } else { 3 }
        },
        _ => 4,
    }
}
run()
