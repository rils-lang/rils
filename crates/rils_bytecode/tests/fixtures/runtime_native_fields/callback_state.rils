fn make_counter() -> fn(i32) -> i32 {
    let mut number = 40;
    fn increment(amount: i32) -> i32 { number = number + amount; number }
    increment
}
{
    let mut callbacks: Vec<fn(i32) -> i32> = Vec::new();
    callbacks.push(make_counter());
    let callback = callbacks.pop().unwrap();
    callback(1);
    callback(1)
}
