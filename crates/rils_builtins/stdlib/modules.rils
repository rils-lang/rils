/// Host-independent core APIs.
pub mod core {
    pub mod option {
        pub use Option;
        pub use Some;
        pub use None;
    }

    pub mod result {
        pub use Result;
        pub use Ok;
        pub use Err;
    }

    pub mod iter {
        pub use Iterator;
        pub use IntoIterator;
        pub use Range;
    }

    pub mod clone {
        pub use Copy;
        pub use Clone;
        pub use clone;
    }

    pub mod default {
        pub use Default;
    }

    pub mod fmt {
        pub use Display;
        pub use Debug;
        pub use Formatter;
        pub use FormatError;
    }

    pub mod cmp {
        pub use Eq;
    }

    pub mod hash {
        pub use Hash;
    }
}

/// Host and platform APIs.
pub mod std {
    pub mod collections {
        pub use Vec;
        pub use HashMap;
        pub use HashSet;
    }

    pub mod io;
    pub mod fs;
}

/// Names imported into every script.
pub mod prelude;
