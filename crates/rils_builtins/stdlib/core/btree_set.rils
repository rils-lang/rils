/// An ordered set backed by a B-tree.
pub struct BTreeSet<T>;

impl<T> BTreeSet<T> {
    /// Creates an empty set.
    #[runtime(core::btree_set::new)]
    fn new() -> Self {}
    /// Returns the number of elements.
    #[runtime(core::btree_set::len)]
    fn len(&self) -> usize {}
    /// Returns whether the set is empty.
    #[runtime(core::btree_set::is_empty)]
    fn is_empty(&self) -> bool {}
    /// Removes all elements.
    #[runtime(core::btree_set::clear)]
    fn clear(&mut self) {}
    /// Tests whether an element is present.
    #[runtime(core::btree_set::contains)]
    fn contains(&self, value: &T) -> bool {}
    /// Inserts an element and reports whether it was new.
    #[runtime(core::btree_set::insert)]
    fn insert(&mut self, value: T) -> bool {}
    /// Removes an element and reports whether it was present.
    #[runtime(core::btree_set::remove)]
    fn remove(&mut self, value: &T) -> bool {}
    /// Clones the smallest element.
    #[runtime(core::btree_set::first_cloned)]
    fn first_cloned(&self) -> Option<T> {}
    /// Clones the largest element.
    #[runtime(core::btree_set::last_cloned)]
    fn last_cloned(&self) -> Option<T> {}
    /// Tests whether every element is present in the other set.
    #[runtime(core::btree_set::is_subset)]
    fn is_subset(&self, other: &BTreeSet<T>) -> bool {}
    /// Tests whether this set contains every element of the other set.
    #[runtime(core::btree_set::is_superset)]
    fn is_superset(&self, other: &BTreeSet<T>) -> bool {}
    /// Tests whether the sets share no elements.
    #[runtime(core::btree_set::is_disjoint)]
    fn is_disjoint(&self, other: &BTreeSet<T>) -> bool {}
    /// Clones the union into a new ordered set.
    #[runtime(core::btree_set::union)]
    fn union(&self, other: &BTreeSet<T>) -> BTreeSet<T> {}
    /// Clones the intersection into a new ordered set.
    #[runtime(core::btree_set::intersection)]
    fn intersection(&self, other: &BTreeSet<T>) -> BTreeSet<T> {}
    /// Clones elements absent from the other set.
    #[runtime(core::btree_set::difference)]
    fn difference(&self, other: &BTreeSet<T>) -> BTreeSet<T> {}
    /// Clones elements present in exactly one set.
    #[runtime(core::btree_set::symmetric_difference)]
    fn symmetric_difference(&self, other: &BTreeSet<T>) -> BTreeSet<T> {}
    /// Consumes the set and iterates over owned elements in order.
    #[runtime(core::btree_set::into_iter)]
    fn into_iter(self) -> Iterator<T> {}
    /// Borrows each element in ascending order.
    #[runtime(core::btree_set::iter)]
    fn iter(&self) -> Iter<&T> {}
}
