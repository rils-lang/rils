/// An ordered map backed by a B-tree.
pub struct BTreeMap<K, V>;

impl<K, V> BTreeMap<K, V> {
    /// Creates an empty map.
    #[runtime(core::btree_map::new)]
    fn new() -> Self {}
    /// Returns the number of entries.
    #[runtime(core::btree_map::len)]
    fn len(&self) -> usize {}
    /// Returns whether the map is empty.
    #[runtime(core::btree_map::is_empty)]
    fn is_empty(&self) -> bool {}
    /// Removes all entries.
    #[runtime(core::btree_map::clear)]
    fn clear(&mut self) {}
    /// Tests whether a key is present.
    #[runtime(core::btree_map::contains_key)]
    fn contains_key(&self, key: &K) -> bool {}
    /// Inserts a key-value pair and returns the previous value.
    #[runtime(core::btree_map::insert)]
    fn insert(&mut self, key: K, value: V) -> Option<V> {}
    /// Clones the value for a key.
    #[runtime(core::btree_map::get_cloned)]
    fn get_cloned(&self, key: &K) -> Option<V> {}
    /// Removes a key and returns its value.
    #[runtime(core::btree_map::remove)]
    fn remove(&mut self, key: &K) -> Option<V> {}
    /// Clones the smallest key.
    #[runtime(core::btree_map::first_key_cloned)]
    fn first_key_cloned(&self) -> Option<K> {}
    /// Clones the largest key.
    #[runtime(core::btree_map::last_key_cloned)]
    fn last_key_cloned(&self) -> Option<K> {}
    /// Consumes the map and iterates over owned entries in key order.
    #[runtime(core::btree_map::into_iter)]
    fn into_iter(self) -> Iterator<(K, V)> {}
}
