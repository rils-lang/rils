/// A single-threaded reference-counted owning handle.
pub struct Rc<T>;

impl<T> Rc<T> {
    /// Creates a new reference-counted handle.
    #[runtime(core::rc::new)]
    fn new(value: T) -> Self {}

    /// Clones the handle without cloning the shared value.
    #[runtime(core::rc::clone)]
    fn clone(&self) -> Self {}

    /// Returns the number of strong handles to the shared value.
    #[runtime(core::rc::strong_count)]
    fn strong_count(&self) -> usize {}

    /// Creates a non-owning weak handle to this allocation.
    #[runtime(core::rc::downgrade)]
    fn downgrade(&self) -> Weak<T> {}
}
