/// A single-threaded interior-mutable value cell.
pub struct Cell<T>;

impl<T> Cell<T> {
    /// Creates a cell containing a value.
    #[runtime(core::cell::new)]
    fn new(value: T) -> Self {}

    /// Clones the current value.
    #[runtime(core::cell::get)]
    fn get(&self) -> T {}

    /// Replaces the current value.
    #[runtime(core::cell::set)]
    fn set(&self, value: T) {}

    /// Replaces and returns the previous value.
    #[runtime(core::cell::replace)]
    fn replace(&self, value: T) -> T {}
}
